#!/usr/bin/env bash

audit_subdomain() {
    domain="$1"
    subdomain="$2"
    result=$(dig +noall +answer "$subdomain.$domain" | awk 'NR == 1 {print $4, $5; exit}')
    read -r record_type destination <<< "$result"

    echo "The subdomain $subdomain is a $record_type record and points to $destination"
}

if [ "$#" -eq 1 ]; then
    audit_subdomain "$1" "www"
    audit_subdomain "$1" "lb-01"
    audit_subdomain "$1" "web-01"
    audit_subdomain "$1" "web-02"
else
    audit_subdomain "$1" "$2"
fi
