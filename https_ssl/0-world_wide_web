#!/usr/bin/env bash
# Display DNS information for a domain's subdomains.

get_subdomain_info() {
    local domain="$1"
    local subdomain="$2"

    dig +noall +answer "$subdomain.$domain" | awk -v subdomain="$subdomain" '
    NR == 1 {
        printf "The subdomain %s is a %s record and points to %s\n", subdomain, $4, $5
    }'
}

domain="$1"

if [ "$#" -eq 2 ]; then
    get_subdomain_info "$domain" "$2"
else
    for subdomain in www lb-01 web-01 web-02; do
        get_subdomain_info "$domain" "$subdomain"
    done
fi
