#!/usr/bin/env bash
# Displays information about the DNS records of subdomains of a domain
display_info() {
  dig "$2.$1" | grep -A1 'ANSWER SECTION:' | tail -1 | awk -v sd="$2" '{print "The subdomain " sd " is a " $4 " record and points to " $5}'
}

if [ "$#" -eq 1 ]
then
  display_info "$1" www
  display_info "$1" lb-01
  display_info "$1" web-01
  display_info "$1" web-02
elif [ "$#" -eq 2 ]
then
  display_info "$1" "$2"
fi
