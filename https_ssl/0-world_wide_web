#!/usr/bin/env bash
# This script displays information about a domain's subdomains.

check_subdomain() {
    local domain="$1"
    local subdomain="$2"

    dig +noall +answer "$subdomain.$domain" | awk -v subdomain="$subdomain" '{
        print "The subdomain " subdomain " is a " $4 " record and points to " $5
    }'
}

if [ "$#" -eq 1 ]; then
    for subdomain in www lb-01 web-01 web-02; do
        check_subdomain "$1" "$subdomain"
    done
else
    check_subdomain "$1" "$2"
fi
